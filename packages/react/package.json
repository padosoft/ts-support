{
	"name": "@padosoft/react",
	"description": "React hooks and HOC utilities for padosoft projects, including useConfig and component composition helpers",
	"keywords": [
		"react",
		"hooks",
		"hoc",
		"typescript",
		"padosoft"
	],
	"version": "1.3.0",
	"type": "module",
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"url": "git+https://github.com/padosoft/ts-support.git"
	},
	"scripts": {
		"build": "tsdown",
		"ts:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@padosoft/config": "workspace:^",
		"react": "^19.2.8",
		"@types/react": "^19.2.17"
	},
	"dependencies": {
		"@padosoft/utilities": "workspace:^"
	},
	"peerDependencies": {
		"react": ">=19.2.8"
	},
	"exports": {
		".": {
			"default": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./component-registry": {
			"default": "./dist/component-registry.mjs",
			"types": "./dist/component-registry.d.mts"
		},
		"./config": {
			"default": "./dist/config.mjs",
			"types": "./dist/config.d.mts"
		},
		"./hoc": {
			"default": "./dist/hoc.mjs",
			"types": "./dist/hoc.d.mts"
		},
		"./memo": {
			"default": "./dist/memo.mjs",
			"types": "./dist/memo.d.mts"
		},
		"./use-component-override": {
			"default": "./dist/use-component-override.mjs",
			"types": "./dist/use-component-override.d.mts"
		},
		"./with-component-override": {
			"default": "./dist/with-component-override.mjs",
			"types": "./dist/with-component-override.d.mts"
		},
		"./package.json": "./package.json"
	}
}
