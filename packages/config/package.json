{
	"name": "@padosoft/config",
	"description": "Shared TypeScript, Biome, and tsdown configurations for padosoft packages and apps",
	"keywords": [
		"typescript",
		"tsconfig",
		"biome",
		"tsdown",
		"config",
		"padosoft"
	],
	"type": "module",
	"version": "1.4.1",
	"repository": {
		"url": "git+https://github.com/padosoft/ts-support.git"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsdown",
		"ts:check": "tsc --noEmit"
	},
	"files": [
		"dist",
		"src"
	],
	"exports": {
		"./compiler/plugins/hono-zod": {
			"default": "./dist/compiler/plugins/hono-zod/index.mjs",
			"types": "./dist/compiler/plugins/hono-zod/index.d.mts"
		},
		"./compiler/plugins/hono-zod/esbuild": {
			"default": "./dist/compiler/plugins/hono-zod/esbuild.mjs",
			"types": "./dist/compiler/plugins/hono-zod/esbuild.d.mts"
		},
		"./compiler/plugins/hono-zod/farm": {
			"default": "./dist/compiler/plugins/hono-zod/farm.mjs",
			"types": "./dist/compiler/plugins/hono-zod/farm.d.mts"
		},
		"./compiler/plugins/hono-zod/rolldown": {
			"default": "./dist/compiler/plugins/hono-zod/rolldown.mjs",
			"types": "./dist/compiler/plugins/hono-zod/rolldown.d.mts"
		},
		"./compiler/plugins/hono-zod/rollup": {
			"default": "./dist/compiler/plugins/hono-zod/rollup.mjs",
			"types": "./dist/compiler/plugins/hono-zod/rollup.d.mts"
		},
		"./compiler/plugins/hono-zod/rspack": {
			"default": "./dist/compiler/plugins/hono-zod/rspack.mjs",
			"types": "./dist/compiler/plugins/hono-zod/rspack.d.mts"
		},
		"./compiler/plugins/hono-zod/vite": {
			"default": "./dist/compiler/plugins/hono-zod/vite.mjs",
			"types": "./dist/compiler/plugins/hono-zod/vite.d.mts"
		},
		"./compiler/plugins/hono-zod/webpack": {
			"default": "./dist/compiler/plugins/hono-zod/webpack.mjs",
			"types": "./dist/compiler/plugins/hono-zod/webpack.d.mts"
		},
		"./compiler/tsdown": {
			"default": "./dist/compiler/tsdown.mjs",
			"types": "./dist/compiler/tsdown.d.mts"
		},
		"./compiler/utils": {
			"default": "./dist/compiler/utils/index.mjs",
			"types": "./dist/compiler/utils/index.d.mts"
		},
		"./compiler/utils/exports": {
			"default": "./dist/compiler/utils/exports.mjs",
			"types": "./dist/compiler/utils/exports.d.mts"
		},
		"./types/css": {
			"default": "./dist/types/css.mjs",
			"types": "./dist/types/css.d.mts"
		},
		"./types/expo-router": {
			"default": "./dist/types/expo-router.mjs",
			"types": "./dist/types/expo-router.d.mts"
		},
		"./types/i18next": {
			"default": "./dist/types/i18next.mjs",
			"types": "./dist/types/i18next.d.mts"
		},
		"./types/nativewind": {
			"default": "./dist/types/nativewind.mjs",
			"types": "./dist/types/nativewind.d.mts"
		},
		"./package.json": "./package.json",
		"./typescript/base": "./src/typescript/base.json",
		"./typescript/base-ts7": "./src/typescript/base-ts7.json",
		"./typescript/compiler": "./src/typescript/compiler.json",
		"./typescript/expo": "./src/typescript/expo.json",
		"./typescript/hono": "./src/typescript/hono.json",
		"./tools/biome": "./src/tools/biome.json"
	},
	"dependencies": {
		"unplugin": "^3.3.0"
	}
}
