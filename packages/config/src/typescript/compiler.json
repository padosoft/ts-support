{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base-ts7",
	"compilerOptions": {
		"composite": false,
		"declaration": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"isolatedDeclarations": true,
		"allowJs": false,
		"types": ["@types/node", "@types/bun"]
	}
}
