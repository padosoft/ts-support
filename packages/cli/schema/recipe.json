{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"title": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"deps": {
			"default": {
				"add": [],
				"dev": [],
				"remove": []
			},
			"type": "object",
			"properties": {
				"add": {
					"default": [],
					"description": "dependencies",
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"dev": {
					"default": [],
					"description": "devDependencies",
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"remove": {
					"default": [],
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"additionalProperties": false
		},
		"merge": {
			"default": {},
			"description": "JSON files deep-merged into the project: objects merge, arrays gain missing items, values are replaced",
			"type": "object",
			"propertyNames": {
				"type": "string"
			},
			"additionalProperties": {
				"type": "object",
				"propertyNames": {
					"type": "string"
				},
				"additionalProperties": {}
			}
		}
	},
	"required": ["title"],
	"additionalProperties": false
}
