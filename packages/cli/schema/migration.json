{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"title": {
			"type": "string",
			"minLength": 1
		},
		"description": {
			"type": "string"
		},
		"kind": {
			"default": "required",
			"description": "Optional migrations are offered, never required",
			"type": "string",
			"enum": ["required", "optional"]
		},
		"when": {
			"default": {},
			"description": "Applies only while every axis has this option",
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
			},
			"additionalProperties": {
				"type": "string",
				"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
			}
		},
		"set": {
			"default": {},
			"description": "Choices recorded once applied",
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
			},
			"additionalProperties": {
				"type": "string",
				"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
			}
		},
		"deps": {
			"default": {
				"add": [],
				"dev": [],
				"remove": []
			},
			"type": "object",
			"properties": {
				"add": {
					"default": [],
					"description": "dependencies",
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"dev": {
					"default": [],
					"description": "devDependencies",
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"remove": {
					"default": [],
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"additionalProperties": false
		},
		"verify": {
			"default": [],
			"description": "Commands that must pass before the migration is marked",
			"type": "array",
			"items": {
				"type": "string"
			}
		}
	},
	"required": ["title"],
	"additionalProperties": false
}
