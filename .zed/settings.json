{
	"format_on_save": "on",
	"code_actions_on_format": {
		"source.fixAll.biome": true,
		"source.organizeImports.biome": true
	},
	"formatter": {
		"language_server": {
			"name": "biome"
		}
	},
	"language_servers": ["biome", "..."],
	"languages": {
		"CSS": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"GraphQL": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JavaScript": {
			"language_servers": [
				"typescript-ls",
				"vtsls",
				"!typescript-language-server",
				"..."
			],
			"prettier": {
				"allowed": false
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSON": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSONC": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"JSX": {
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"TSX": {
			"language_servers": [
				"typescript-ls",
				"vtsls",
				"!typescript-language-server",
				"..."
			],
			"prettier": {
				"allowed": false
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		},
		"TypeScript": {
			"language_servers": [
				"typescript-ls",
				"vtsls",
				"!typescript-language-server",
				"..."
			],
			"prettier": {
				"allowed": false
			},
			"formatter": {
				"language_server": {
					"name": "biome"
				}
			}
		}
	},
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": true
			}
		}
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	}
}
